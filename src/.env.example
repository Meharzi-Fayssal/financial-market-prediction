# ===== Emplacements communs =====
# Dossiers relatifs au projet (ou chemins absolus).
DATA_DIR=data
OUTPUT_DIR=outputs

# ===== Contrôle des périodes exportées par prepare.py (NE modifie PAS prepare.py) =====
# date_id représente un indice de jour, pas une date calendaire.
TRAIN_START_DATE=0
TRAIN_END_DATE=109
VAL_START_DATE=110
VAL_END_DATE=153
TEST_START_DATE=154
TEST_END_DATE=219
# Dernier date_id de la partition 0 (test : 154-169 en partition 0, 170-219 en partition 1).
PARTITION_0_LAST_DATE=169

# ===== Colonnes communes à tous les modèles =====
# Les modèles n'utilisent PAS les autres responder comme prédicteurs.
TARGET_COLUMN=responder_6
WEIGHT_COLUMN=weight
DATE_COLUMN=date_id
TIME_COLUMN=time_id
SYMBOL_COLUMN=symbol_id
FEATURE_PREFIX=feature_
N_FEATURES=79
# Colonnes 100 % vides dans part-0.parquet selon l’EDA, exclues à l’identique des entrées train/val/test.
# Conserver cette liste validée ; ne modifie ni prepare.py ni les CSV sources.
EXCLUDED_FEATURES=feature_00,feature_01,feature_02,feature_03,feature_04,feature_21,feature_26,feature_27,feature_31
RANDOM_SEED=42

# ===== Exécution =====
# Modèles à lancer (liste séparée par des virgules).
MODELS=ridge,gradient_boosting,lstm
# 0 = utiliser toutes les lignes. Une valeur positive limite les lignes, UNIQUEMENT pour le débogage.
MAX_TRAIN_ROWS=0
MAX_VAL_ROWS=0
MAX_TEST_ROWS=0
# Nombre de points affichés dans les figures (l'évaluation reste sur toutes les lignes).
PLOT_SAMPLE_SIZE=5000
# true = écrire de volumineux CSV de prédictions du test ; false = statistiques et figures uniquement.
SAVE_TEST_PREDICTIONS=false

# ===== Ridge (standardisation train + masques NaN) =====
# Valeurs candidates de la force de régularisation L2 ; meilleure choisie sur validation.
RIDGE_ALPHAS=0.1,1,10,100

# ===== Gradient Boosting / LightGBM (NaN conservés nativement) =====

# Nombre maximal d'arbres à construire.
GBM_N_ESTIMATORS=500
# Contribution de chaque nouvel arbre (plus petit = apprentissage plus lent).
GBM_LEARNING_RATE=0.05
# Complexité maximale des arbres (nombre de feuilles).
GBM_NUM_LEAVES=31
# Nombre minimal d'observations dans une feuille.
GBM_MIN_CHILD_SAMPLES=20
# Arrêt anticipé après N itérations sans amélioration sur validation.
GBM_EARLY_STOPPING_ROUNDS=30

# ===== LSTM / PyTorch (standardisation train + masques NaN) =====
# Nombre d'observations passées et courantes du même symbol_id (sans les futurs instants).
LSTM_SEQUENCE_LENGTH=20
# Nombre d'unités cachées de chaque couche récurrente.
LSTM_HIDDEN_SIZE=64
# Nombre de couches LSTM empilées.
LSTM_NUM_LAYERS=2
# Regularisation dropout entre couches si LSTM_NUM_LAYERS > 1.
LSTM_DROPOUT=0.2
# Nombre maximal de passages sur les données d'entraînement.
LSTM_EPOCHS=20
# Nombre d'observations par mini-lot d'entraînement.
LSTM_BATCH_SIZE=256
# Pas d'apprentissage de l'optimiseur Adam.
LSTM_LEARNING_RATE=0.001
# Nombre d'époques sans progrès avant l'arrêt anticipé.
LSTM_PATIENCE=4
# auto = GPU si disponible ; cpu = toujours CPU ; cuda = exige un GPU compatible.
LSTM_DEVICE=auto
